# NovaPay Local Environment Variables
# Copy this file to .env and customize as needed

# Database Configuration
DB_HOST=postgres
DB_PORT=5432
DB_NAME=novapay
DB_USERNAME=np
DB_PASSWORD=np

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# AWS Configuration (for LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

# SQS Configuration
SQS_QUEUE_URL=http://localstack:4566/000000000000/novapay-webhook-queue

# Service Configuration
NODE_ENV=development
SERVICE_NAME=payment-service

# Note: These values are already set in docker-compose.yml
# This file is for reference and can be used for local development
# outside of Docker (e.g., running services directly with node)
