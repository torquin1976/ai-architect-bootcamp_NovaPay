version: '3.8'

services:
  # PostgreSQL Database
  postgres:
    image: postgres:15-alpine
    container_name: novapay-postgres
    environment:
      POSTGRES_DB: novapay
      POSTGRES_USER: np
      POSTGRES_PASSWORD: np
    ports:
      - "5432:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./init-db.sql:/docker-entrypoint-initdb.d/init-db.sql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U np -d novapay"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Redis Cache
  redis:
    image: redis:7-alpine
    container_name: novapay-redis
    ports:
      - "6379:6379"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 10s
      timeout: 5s
      retries: 5

  # LocalStack for SQS (AWS services emulation)
  localstack:
    image: localstack/localstack:latest
    container_name: novapay-localstack
    ports:
      - "4566:4566"  # LocalStack gateway
    environment:
      SERVICES: sqs
      DEBUG: 0
      AWS_DEFAULT_REGION: us-east-1
      DOCKER_HOST: unix:///var/run/docker.sock
    volumes:
      - ./localstack-init.sh:/etc/localstack/init/ready.d/init-aws.sh
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:4566/_localstack/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Payment Service (handles /auth, /charge, /refund)
  payment-service:
    build:
      context: ./DockerFiles/Payment
      dockerfile: dockerfile
    container_name: novapay-payment
    ports:
      - "3001:3000"
    environment:
      NODE_ENV: development
      SERVICE_NAME: payment-service
      AWS_REGION: us-east-1
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: novapay
      DB_USERNAME: np
      DB_PASSWORD: np
      REDIS_HOST: redis
      REDIS_PORT: 6379
      SQS_QUEUE_URL: http://localstack:4566/000000000000/novapay-webhook-queue
      AWS_ACCESS_KEY_ID: test
      AWS_SECRET_ACCESS_KEY: test
      AWS_ENDPOINT_URL: http://localstack:4566
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
      localstack:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  # KYC Service (handles /kyc)
  kyc-service:
    build:
      context: ./DockerFiles/KYC
      dockerfile: dockerfile
    container_name: novapay-kyc
    ports:
      - "3002:3000"
    environment:
      NODE_ENV: development
      SERVICE_NAME: kyc-service
      AWS_REGION: us-east-1
      DB_HOST: postgres
      DB_PORT: 5432
      DB_NAME: novapay
      DB_USERNAME: np
      DB_PASSWORD: np
      REDIS_HOST: redis
      REDIS_PORT: 6379
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "curl", "-f", "http://localhost:3000/health"]
      interval: 10s
      timeout: 5s
      retries: 5

  # Webhook Service (background worker)
  webhook-service:
    build:
      context: ./DockerFiles/WebHook
      dockerfile: dockerfile
    container_name: novapay-webhook
    environment:
      NODE_ENV: development
      SERVICE_NAME: webhook-service
      AWS_REGION: us-east-1
      SQS_QUEUE_URL: http://localstack:4566/000000000000/novapay-webhook-queue
      AWS_ACCESS_KEY_ID: test
      AWS_SECRET_ACCESS_KEY: test
      AWS_ENDPOINT_URL: http://localstack:4566
    depends_on:
      localstack:
        condition: service_healthy
    restart: unless-stopped

volumes:
  postgres_data:

networks:
  default:
    name: novapay-network
