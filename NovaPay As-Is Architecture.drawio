        <mxCell id="3__SB66o9B6beJgqAfNg-47" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;font style=&quot;font-size: 10px; color: rgb(213, 232, 212);&quot; face=&quot;Comic Sans MS&quot;&gt;/auth&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/charge&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;/span&gt;/refund&lt;br&gt;/kyc&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/webhook&amp;nbsp;&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/settle&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 10px; color: rgb(213, 232, 212);&quot;&gt;&lt;font face=&quot;Comic Sans MS&quot;&gt;/admin&amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;/reports&lt;/font&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="70" width="220" x="-250" y="160" as="geometry" />
        </mxCell>
        <mxCell id="3__SB66o9B6beJgqAfNg-48" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;font style=&quot;font-size: 10px; color: rgb(213, 232, 212);&quot; face=&quot;Comic Sans MS&quot;&gt;us-east-1a ONLY | Single AZ&lt;/font&gt;" vertex="1">
          <mxGeometry height="30" width="300" x="-260" y="90" as="geometry" />
        </mxCell>
        <mxCell id="3__SB66o9B6beJgqAfNg-49" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;container=0;" value="&lt;font style=&quot;font-size: 8px; color: rgb(228, 166, 73);&quot; face=&quot;Comic Sans MS&quot;&gt;In-memory idempotency&amp;nbsp; |&amp;nbsp; In-memory webhook queue&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 8px; color: rgb(255, 0, 0);&quot; face=&quot;Comic Sans MS&quot;&gt;KYC blocks event loop&amp;nbsp; |&amp;nbsp; No graceful shutdown&lt;/font&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="40" width="220" x="-250" y="230" as="geometry" />
        </mxCell>
        <mxCell id="CQx-yA7mg2lGLL-Iz3X_-2" parent="0" style="locked=1;" value="Single Points of Failure" />
        <mxCell id="gKg1kIFE49NrGPejPkXz-2" parent="CQx-yA7mg2lGLL-Iz3X_-2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#6a00ff;fontColor=#ffffff;strokeColor=#3700CC;" value="" vertex="1">
          <mxGeometry height="270" width="530" x="-430" y="590" as="geometry" />
        </mxCell>
        <mxCell id="gKg1kIFE49NrGPejPkXz-3" parent="CQx-yA7mg2lGLL-Iz3X_-2" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;Single Points of Failure&lt;/font&gt;&lt;/h1&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;1. Elastic IP - Single AZ, requires manual de/re-attachment.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;2. Single EC2 instance - If VM goes down, entire application and pending transactions are lost.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;3. All activities are on a single process, that is handling all incoming, active, outgoing transactions.&amp;nbsp; One error on /refund could tank entire stack of transactions.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;4. Memory failure leads to existing transactions being lost&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;5. Database Cache isolated to this one machine, instead of spread across multiple or Elasticache.&lt;/font&gt;&lt;/p&gt;&lt;p&gt;&lt;font style=&quot;color: rgb(49, 248, 255);&quot;&gt;6. Single AZ RDS database, without replica.&amp;nbsp; Loss of AZ or database gets overwhelmed and system is degraded or down.&lt;/font&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="250" width="480" x="-400" y="600" as="geometry" />
        </mxCell>
